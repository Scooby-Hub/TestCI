# Системные файлы Windows (особенно если папка на рабочем столе)
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Временные файлы текстовых редакторов и VS Code
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Логи ошибок (они постоянно меняются и засоряют коммиты)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Секретные ключи и пароли (НИКОГДА не отправляйте их на GitHub)
.env
.env.local
*.pem
*.key
